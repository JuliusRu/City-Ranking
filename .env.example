# Database
# DEV: local Postgres via docker-compose (run `docker compose up -d` first).
# Host port is 5433 to avoid a native Postgres often already on localhost:5432.
# Never develop against the production DB.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/city_ranking?schema=public"
# PROD (in Coolify): Supabase IPv4 pooler, session mode — NOT the direct db.<ref>.supabase.co
# host (that one is IPv6-only and unreachable from the container). Example shape:
# DATABASE_URL="postgresql://postgres.<ref>:<url-encoded-pw>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase Auth (anon key is public / client-safe — find both in Supabase
# dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# Cesium (optional - only needed if upgrading to Cesium Ion)
# CESIUM_ION_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenRouter — powers the "From text" AI quick-add on /visits/new (server-side only).
# Get a key at openrouter.ai → Keys. Default model is google/gemini-3.1-flash-lite
# (~$0.25/M tokens, fractions of a cent per visit). Override with a "...:free" model
# for zero cost, but free models are often upstream-rate-limited.
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="google/gemini-3.1-flash-lite"
