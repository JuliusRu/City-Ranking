generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

// How much of a visit was spent in a given district — kept SEPARATE from the
// district rating so "where I actually was" and "how good it is" are independent
// (you can be based in a mediocre area yet love one you barely saw).
enum DistrictFrequency {
  PASSED_THROUGH
  FEW_TIMES
  A_LOT
  BASED_HERE
}

enum VenueType {
  RESTAURANT
  CAFE
  BAR
  BAKERY
  CLUB
  OTHER
}

model User {
  id            String   @id @default(cuid())
  authId        String?  @unique @map("auth_id")
  email         String?  @unique
  name          String?
  username      String?  @unique
  bio           String?  @db.Text
  avatarUrl     String?  @map("avatar_url")
  publicProfile Boolean  @default(false) @map("public_profile")
  // Null until the user finishes (or skips) the first-run onboarding flow. The
  // home page redirects to /onboarding while this is null; set on completion or
  // skip so the redirect fires exactly once per account.
  onboardedAt   DateTime? @map("onboarded_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  visits   Visit[]
  settings UserSettings?
  venues   Venue[]

  // Social graph. `following` = edges where this user is the follower (people
  // they follow); `followers` = edges where they are the followee.
  following Follow[]      @relation("follower")
  followers Follow[]      @relation("following")
  likes     VisitLike[]
  comments  VisitComment[]

  @@index([username])
  @@map("users")
}

model UserSettings {
  id               String  @id @default(cuid())
  userId           String  @unique @map("user_id")
  theme            String  @default("dark")
  dateFormat       String  @default("MM/DD/YYYY") @map("date_format")
  defaultSortBy    String  @default("createdAt") @map("default_sort_by")
  defaultSortOrder String  @default("desc") @map("default_sort_order")
  homeCurrency     String  @default("USD") @map("home_currency")
  distanceUnit     String  @default("km") @map("distance_unit")
  defaultTripType  String? @map("default_trip_type")
  defaultBudget    String? @map("default_budget")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model City {
  id         String   @id @default(cuid())
  name       String
  country    String
  state      String?
  latitude   Float
  longitude  Float
  timezone   String?
  population Int?
  externalId String?  @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  visits    Visit[]
  districts District[]

  @@unique([name, country, latitude, longitude])
  @@index([name])
  @@index([country])
  @@index([latitude, longitude])
  @@map("cities")
}

model Visit {
  id          String    @id @default(cuid())
  rating      Int       @db.SmallInt
  comment     String?   @db.Text
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  tripType    String?   @map("trip_type")
  budgetLevel String?   @map("budget_level")
  visibility  Visibility @default(PRIVATE)
  wouldReturn Boolean?  @map("would_return")
  highlights  String?   @db.Text
  transport   String?
  photoUrl    String?   @map("photo_url")
  userId      String    @map("user_id")
  cityId      String    @map("city_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  districts VisitDistrict[]
  likes     VisitLike[]
  comments  VisitComment[]

  @@unique([userId, cityId, startDate])
  @@index([userId])
  @@index([cityId])
  @@index([startDate])
  @@index([rating])
  @@map("visits")
}

// A district/neighbourhood catalog entry, scoped to a city. Shared across users
// and visits (geocoded via Nominatim) so we can later aggregate "best districts
// in <city>" and drop sub-pins on the globe.
model District {
  id         String   @id @default(cuid())
  cityId     String   @map("city_id")
  name       String
  latitude   Float
  longitude  Float
  externalId String?  @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  city           City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  visitDistricts VisitDistrict[]

  @@unique([cityId, name])
  @@index([cityId])
  @@map("districts")
}

// Join: which districts a visit covered, each with its own rating (appeal) and
// frequency (how much time spent) — the two independent dimensions.
model VisitDistrict {
  id         String            @id @default(cuid())
  visitId    String            @map("visit_id")
  districtId String            @map("district_id")
  rating     Int               @db.SmallInt
  frequency  DistrictFrequency @default(FEW_TIMES)
  createdAt  DateTime          @default(now()) @map("created_at")

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([visitId, districtId])
  @@index([visitId])
  @@index([districtId])
  @@map("visit_districts")
}

// A standalone place the user rates — restaurant / café / bar / etc. Deliberately
// NOT tied to a City or Visit: it's its own category (your personal food & drink
// list). `location` is free text; coordinates are optional for a future map view.
model Venue {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  name        String
  type        VenueType @default(RESTAURANT)
  rating      Int       @db.SmallInt
  location    String?
  priceLevel  String?   @map("price_level")
  note        String?   @db.Text
  wouldReturn Boolean?  @map("would_return")
  photoUrl    String?   @map("photo_url")
  latitude    Float?
  longitude   Float?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("venues")
}

// Directed follow edge: `follower` follows `following`. One row per pair. Powers
// the "Following" tab of the feed. Both sides cascade-delete with the user.
model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// A like/reaction on a shared visit. One per (user, visit) — the unique key makes
// the toggle idempotent. Cascade-deletes with either the liker or the visit.
model VisitLike {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  visitId   String   @map("visit_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([userId, visitId])
  @@index([visitId])
  @@map("visit_likes")
}

// A comment on a shared visit. Many per visit, newest-first in the UI. Cascade-
// deletes with either the author or the visit.
model VisitComment {
  id        String   @id @default(cuid())
  visitId   String   @map("visit_id")
  userId    String   @map("user_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([userId])
  @@map("visit_comments")
}
